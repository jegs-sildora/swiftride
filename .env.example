# ===========================================================
# SwiftRide ERP — Environment Variables Template
# Copy this file to .env and fill in all values before running.
# NEVER commit the populated .env file to version control.
# ===========================================================

APP_ENV=local
APP_DEBUG=true

# ===========================================================
# DATABASE — Single PostgreSQL instance shared by all services
# All 5 microservices use the same user/password.
# Each service connects to its own database within this instance.
# ===========================================================

DB_USER=swiftride
DB_PASSWORD=CHANGE_ME_db_password

# ===========================================================
# LARAVEL APPLICATION KEYS
# Generate each with: php artisan key:generate --show
# Run once per service directory.
# ===========================================================

GATEWAY_APP_KEY=base64:CHANGE_ME_gateway_app_key
FLEET_APP_KEY=base64:CHANGE_ME_fleet_app_key
CRM_APP_KEY=base64:CHANGE_ME_crm_app_key
BOOKING_APP_KEY=base64:CHANGE_ME_booking_app_key
BILLING_APP_KEY=base64:CHANGE_ME_billing_app_key

# ===========================================================
# JWT SECRET
# Generate with: php artisan jwt:secret (in gateway service)
# ===========================================================

JWT_SECRET=CHANGE_ME_jwt_secret_minimum_32_characters_long

# ===========================================================
# SERVICE PUBLIC URLs (used outside Docker / Render deployment)
# In Docker, services communicate via internal DNS (e.g., http://fleet:8001)
# These are set in docker-compose.yml directly.
# ===========================================================

GATEWAY_APP_URL=http://localhost:8000
FLEET_APP_URL=http://localhost:8001
CRM_APP_URL=http://localhost:8002
BOOKING_APP_URL=http://localhost:8003
BILLING_APP_URL=http://localhost:8004

# ===========================================================
# FRONTEND
# Point the React SPA at the API Gateway.
# On Render, replace with your deployed Gateway Web Service URL.
# ===========================================================

VITE_API_GATEWAY_URL=http://localhost:8000
